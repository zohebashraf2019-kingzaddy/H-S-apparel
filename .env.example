# ── Square (https://developer.squareup.com/apps) ──
# Browser-safe IDs (baked into the build)
PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxx
PUBLIC_SQUARE_LOCATION_ID=LXXXXXXXXXXXX
PUBLIC_SQUARE_ENV=sandbox
# Server-only secrets (used by /api/checkout)
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=LXXXXXXXXXXXX
SQUARE_ENV=sandbox

# ── Email (optional, https://resend.com) ──
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="H&S Apparel <orders@yourdomain.com>"
CONTACT_TO_EMAIL=you@example.com
ORDER_NOTIFY_EMAIL=you@example.com
